// Creates the live game state, but only the very first time
function everInit() {
  if (state.ever) return; // already set up, so don't reset the game
  state.ever = {
    turnsUntilChest: everRandom(EVER_CONFIG.chestMin, EVER_CONFIG.chestMax),
    turnsUntilEvent: everRandom(EVER_CONFIG.eventMin, EVER_CONFIG.eventMax),
    baseLevel: 1,
    inventory: everBuildInventory(),
    health: EVER_CONFIG.startHealth,
    thirst: EVER_CONFIG.startThirst,
    hunger: EVER_CONFIG.startHunger,
    engineLevel: 0,            // 0 = no engine yet
    power: 0,                  // the engine's current power
    equipped: [],              // ship weapons currently mounted
    lastEquipped: null,        // the weapon most recently mounted or removed
    chestsOpened: 0,
    lastLoot: null,            // text describing the most recent drop
    lastEvent: null,           // name of the most recent event
    lastUsed: null,            // the item most recently used with /use
    lastTickedAction: null,    // stops Retry from counting a turn twice
    pendingChest: null,        // kill-drop note waiting for the AI to narrate
    pendingEvent: null,        // (older system) event note waiting for the AI
    pendingDeath: null,        // death note waiting for the AI to narrate
    pendingSalvage: false,     // (older system) true after the player types /salvage
    salvageNote: null,         // salvage haul rolled in Input, narrated this turn
    preRollAction: null,       // which turn the same-turn rolls were done for
    preRollNote: "",           // the note from those rolls (reused by Retry)
    dead: false                // true once health hits 0
  };
}

everInit();


