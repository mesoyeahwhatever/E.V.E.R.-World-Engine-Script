// Picks a whole number between min and max (both included)
function everRandom(min, max) {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

// Keeps a number between 0 and the item cap
function everClamp(value) {
  return Math.max(0, Math.min(EVER_CONFIG.maxItemCount, value));
}

// Picks a position from a list of weights.
// Example: [50, 25, 15, 8, 2] returns 0 about half the time, 4 about 2% of the time.
function everWeightedIndex(weights) {
  // Add up all the weights to get the total
  let total = 0;
  for (let i = 0; i < weights.length; i++) {
    total += weights[i];
  }

  // Roll a random number between 0 and the total
  let roll = Math.random() * total;

  // Walk through the weights, subtracting each one.
  // The first time the roll drops below 0, that's the winner.
  for (let i = 0; i < weights.length; i++) {
    roll -= weights[i];
    if (roll < 0) return i;
  }

  return weights.length - 1; // safety net, shouldn't normally be reached
}

// The name of the base at a given level. Past the last named tier it continues from
// the final name: "Reaper Tank Mk.2", "Reaper Tank Mk.3", and so on.
function everTierName(level) {
  const tiers = EVER_CONFIG.baseTiers;
  if (level <= tiers.length) return tiers[level - 1];
  return tiers[tiers.length - 1] + " Mk." + (level - tiers.length + 1);
}

// Builds the starting inventory from the items listed in the settings
function everBuildInventory() {
  const inv = {};
  for (const name in EVER_CONFIG.items) {
    inv[name] = everClamp(EVER_CONFIG.items[name]);
  }
  return inv;
}

// Updates a story card with this title, or creates it if it doesn't exist
function everUpsertCard(title, entry, type) {
  for (let i = 0; i < storyCards.length; i++) {
    if (storyCards[i].keys === title) {
      storyCards[i].entry = entry;
      return;
    }
  }
  addStoryCard(title, entry, type);
}


