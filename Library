// Lays "extra" over "base" and returns the result. Objects are merged setting by setting;
// everything else (numbers, text, lists) is simply replaced by the world's version.
function everDeepMerge(base, extra) {
  const result = {};
  for (const key in base) {
    result[key] = base[key];
  }
  for (const key in extra) {
    const extraIsObject = extra[key] && typeof extra[key] === "object" && !Array.isArray(extra[key]);
    const baseIsObject = base[key] && typeof base[key] === "object" && !Array.isArray(base[key]);
    if (extraIsObject && baseIsObject) {
      result[key] = everDeepMerge(base[key], extra[key]);   // merge inside nested blocks
    } else {
      result[key] = extra[key];
    }
  }
  return result;
}

// A typo in the world name should fail loudly, not quietly run the wrong world
if (!EVER_PRESETS[EVER_ACTIVE_PRESET]) {
  throw new Error("E.V.E.R.: unknown world '" + EVER_ACTIVE_PRESET +
    "'. Use one of: " + Object.keys(EVER_PRESETS).join(", "));
}

// The settings the rest of the script reads
const EVER_CONFIG = everDeepMerge(EVER_SHARED, EVER_PRESETS[EVER_ACTIVE_PRESET]);


